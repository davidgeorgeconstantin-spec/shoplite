PORT=4000
# Frontend URL (for CORS and Stripe redirect URLs)
CLIENT_URL=http://localhost:3000/shoplite
# Stripe TEST mode key (starts with sk_test_). Free, no real money. Leave empty to disable.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# Optional: import products from a WooCommerce store (REST API keys, read-only)
WOO_URL=
WOO_KEY=
WOO_SECRET=
